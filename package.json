{
  "name": "archivist",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && vite build --config web/vite.config.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "cli": "node dist/cli/index.js",
    "serve": "node dist/server/index.js",
    "dev": "concurrently -k \"tsup --watch\" \"vite --config web/vite.config.ts\"",
    "postinstall": "npx tsx scripts/compile-freeze-dry.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.0",
    "@tanstack/react-virtual": "^3.13.23",
    "better-sqlite3": "^12.8.0",
    "bplist-parser": "^0.3.2",
    "cheerio": "^1.2.0",
    "chrome-cookies-secure": "^3.0.1",
    "env-paths": "^4.0.0",
    "express": "^5.2.1",
    "freeze-dry": "^1.0.0",
    "gif-frames": "^1.0.1",
    "image-size": "^2.0.2",
    "is-reachable": "^6.1.0",
    "jsdom": "^29.0.1",
    "md5": "^2.3.0",
    "node-pinboard": "^2.0.1",
    "node-wget": "^0.4.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer": "^24.40.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hotkeys-hook": "^5.2.4",
    "sharp": "^0.34.5",
    "tmp": "^0.2.5",
    "usearch": "^2.21.4",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/md5": "^2.3.6",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/tmp": "^0.2.6",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
