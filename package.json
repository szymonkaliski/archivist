{
  "name": "archivist",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup && vite build --config web/vite.config.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "cli": "node dist/cli/index.js",
    "serve": "node dist/server/index.js",
    "dev": "concurrently -k \"tsup --watch\" \"vite --config web/vite.config.ts\"",
    "postinstall": "node scripts/compile-freeze-dry.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@tanstack/react-virtual": "^3.14.26",
    "better-sqlite3": "^13.0.3",
    "bplist-parser": "^0.3.2",
    "chrome-cookies-secure": "^3.0.2",
    "env-paths": "^4.0.0",
    "express": "^5.3.0",
    "freeze-dry": "^1.0.0",
    "is-reachable": "^6.1.0",
    "jsdom": "^29.1.1",
    "md5": "^2.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "puppeteer": "^25.17.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "usearch": "^2.26.5",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "esbuild": "^0.27.4",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "doctype-to-string": "0.1.4"
  }
}
